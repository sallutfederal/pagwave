# ============================================================================
# PAGWAVE BACKEND — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# ============================================================================

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# Matches the Postgres in ../docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://pagwave:pagwave_secret@localhost:5433/pagwave_db?schema=public"

# ─── Redis (sessions, rate-limit, queue) ─────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT Secrets ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET="CHANGE_ME_access_secret_min_64_chars"
JWT_REFRESH_SECRET="CHANGE_ME_refresh_secret_min_64_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Bcrypt ──────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:3000"
# Public URL of the web app: used to build verification / reset links in e-mails.
APP_URL="http://localhost:3000"

# ─── Email (SMTP) ───────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@pagwave.com"

# ─── Crypto / Blockchain ────────────────────────────────────────────────────
# Ethereum / ERC-20 (USDT, USDC)
ETH_RPC_URL="https://mainnet.infura.io/v3/YOUR_INFURA_KEY"
ETH_USDT_CONTRACT="0xdAC17F958D2ee523a2206206994597C13D831ec7"
ETH_USDC_CONTRACT="0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48"

# TRON / TRC-20 (USDT)
TRON_FULL_NODE="https://api.trongrid.io"
TRON_USDT_CONTRACT="TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t"

# Hot wallet (operational — NEVER store large amounts here)
HOT_WALLET_PRIVATE_KEY=""

# ─── KYC Provider ───────────────────────────────────────────────────────────
KYC_PROVIDER_API_KEY=""
KYC_PROVIDER_WEBHOOK_SECRET=""

# ─── Payment Gateway (Stripe / MercadoPago / etc.) ──────────────────────────
PAYMENT_GATEWAY_API_KEY=""
PAYMENT_GATEWAY_WEBHOOK_SECRET=""

# ─── Rate Limiting ──────────────────────────────────────────────────────────
# TRUST_PROXY=true makes the API read the client IP from X-Forwarded-For (sent by the
# web app). Only enable it when the API is NOT reachable directly from the internet.
TRUST_PROXY=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
