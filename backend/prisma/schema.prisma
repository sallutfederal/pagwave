// =============================================================================
// PAGWAVE — Prisma Schema
// =============================================================================
// Financial-grade data model for multi-currency wallets, crypto (USDT/USDC),
// card management, KYC, transactions, and audit logging.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BLOCKED
  CLOSED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum KycDocumentType {
  IDENTITY_FRONT
  IDENTITY_BACK
  PASSPORT
  SELFIE
  PROOF_OF_ADDRESS
  CORPORATE_REGISTRATION
  TAX_ID
}

enum AccountType {
  PERSONAL
  BUSINESS
}

enum WalletType {
  FIAT
  CRYPTO
}

enum CurrencyType {
  FIAT
  CRYPTO
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  EXCHANGE
  CARD_PAYMENT
  CARD_REFUND
  FEE
  INTEREST
  AIRDROP
  STAKING_REWARD
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
  FROZEN
}

enum CardType {
  VIRTUAL
  PHYSICAL
}

enum CardStatus {
  PENDING_ACTIVATION
  ACTIVE
  FROZEN
  BLOCKED
  EXPIRED
  CANCELLED
}

enum CardBrand {
  VISA
  MASTERCARD
}

enum CardVariant {
  DARK
  LIGHT
}

enum CryptoNetwork {
  ETHEREUM
  TRON
  BSC
  POLYGON
  SOLANA
  BITCOIN
  ARBITRUM
  OPTIMISM
}

enum NotificationType {
  TRANSACTION
  SECURITY
  KYC
  CARD
  SYSTEM
  MARKETING
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum AuditAction {
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  TWO_FA_ENABLE
  TWO_FA_DISABLE
  KYC_SUBMIT
  KYC_APPROVE
  KYC_REJECT
  WALLET_CREATE
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  EXCHANGE
  CARD_CREATE
  CARD_FREEZE
  CARD_UNFREEZE
  CARD_CANCEL
  CARD_PAYMENT
  SETTINGS_UPDATE
  API_KEY_CREATE
  API_KEY_REVOKE
  ADMIN_ACTION
}

// ─────────────────────────────────────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String      @unique @db.VarChar(255)
  passwordHash  String      @map("password_hash") @db.VarChar(255)
  role          UserRole    @default(USER)
  status        UserStatus  @default(PENDING_VERIFICATION)
  accountType   AccountType @default(PERSONAL) @map("account_type")

  // Email verification
  emailVerified   Boolean   @default(false) @map("email_verified")
  emailVerifyToken String?  @map("email_verify_token") @db.VarChar(255)

  // Password reset
  passwordResetToken   String?   @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires DateTime? @map("password_reset_expires")

  // Two-factor authentication
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecret  String? @map("two_factor_secret") @db.VarChar(255)

  // Login tracking
  lastLoginAt  DateTime? @map("last_login_at")
  lastLoginIp  String?   @map("last_login_ip") @db.VarChar(45)
  loginCount   Int       @default(0) @map("login_count")
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  profile        UserProfile?
  sessions       Session[]
  wallets        Wallet[]
  cards          Card[]
  kycDocuments   KycDocument[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  apiKeys        ApiKey[]
  beneficiaries  Beneficiary[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model UserProfile {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String  @unique @map("user_id") @db.Uuid
  firstName   String  @map("first_name") @db.VarChar(100)
  lastName    String  @map("last_name") @db.VarChar(100)
  displayName String? @map("display_name") @db.VarChar(100)
  phone       String? @db.VarChar(20)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  nationality String? @db.VarChar(3) // ISO 3166-1 alpha-3

  // Address
  addressLine1 String? @map("address_line_1") @db.VarChar(255)
  addressLine2 String? @map("address_line_2") @db.VarChar(255)
  city         String? @db.VarChar(100)
  state        String? @db.VarChar(100)
  postalCode   String? @map("postal_code") @db.VarChar(20)
  country      String? @db.VarChar(3) // ISO 3166-1 alpha-3

  // Business fields (when accountType = BUSINESS)
  companyName    String? @map("company_name") @db.VarChar(255)
  companyTaxId   String? @map("company_tax_id") @db.VarChar(50)
  companyCountry String? @map("company_country") @db.VarChar(3)

  // Avatar
  avatarUrl  String? @map("avatar_url") @db.VarChar(500)
  avatarHash String? @map("avatar_hash") @db.VarChar(10) // Initials or hash

  // KYC
  kycStatus    KycStatus @default(NOT_STARTED) @map("kyc_status")
  kycLevel     Int       @default(0) @map("kyc_level") // 0=none, 1=basic, 2=full, 3=enhanced
  kycSubmittedAt DateTime? @map("kyc_submitted_at")
  kycApprovedAt  DateTime? @map("kyc_approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([kycStatus])
  @@map("user_profiles")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  refreshToken String   @unique @map("refresh_token") @db.VarChar(500)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  isActive     Boolean  @default(true) @map("is_active")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// CURRENCIES & EXCHANGE RATES
// ─────────────────────────────────────────────────────────────────────────────

model Currency {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String       @unique @db.VarChar(10)  // USD, BRL, USDT, BTC, ETH, etc.
  name     String       @db.VarChar(100)
  symbol   String       @db.VarChar(10) // $, R$, ₿, Ξ, etc.
  type     CurrencyType
  decimals Int          @default(2) // 2 for fiat, 6-18 for crypto
  isActive Boolean      @default(true) @map("is_active")

  // Crypto-specific
  network          CryptoNetwork? // null for fiat
  contractAddress  String?        @map("contract_address") @db.VarChar(100) // ERC-20/TRC-20 contract
  minimumDeposit   Decimal        @default(0) @map("minimum_deposit") @db.Decimal(28, 18)
  minimumWithdrawal Decimal       @default(0) @map("minimum_withdrawal") @db.Decimal(28, 18)
  withdrawalFee    Decimal        @default(0) @map("withdrawal_fee") @db.Decimal(28, 18)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wallets          Wallet[]
  transactionsFrom ExchangeRate[] @relation("FromCurrency")
  transactionsTo   ExchangeRate[] @relation("ToCurrency")

  @@index([code])
  @@index([type])
  @@map("currencies")
}

model ExchangeRate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromCurrencyId String   @map("from_currency_id") @db.Uuid
  toCurrencyId   String   @map("to_currency_id") @db.Uuid
  rate           Decimal  @db.Decimal(28, 18) // High precision for crypto
  spread         Decimal  @default(0) @db.Decimal(8, 6) // Platform spread %
  source         String   @db.VarChar(50) // "binance", "coingecko", "ecb", etc.
  validAt        DateTime @map("valid_at")
  createdAt      DateTime @default(now()) @map("created_at")

  fromCurrency Currency @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrency   Currency @relation("ToCurrency", fields: [toCurrencyId], references: [id])

  @@index([fromCurrencyId, toCurrencyId])
  @@index([validAt])
  @@map("exchange_rates")
}

// ─────────────────────────────────────────────────────────────────────────────
// WALLETS
// ─────────────────────────────────────────────────────────────────────────────

model Wallet {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  currencyId String     @map("currency_id") @db.Uuid
  type       WalletType
  label      String?    @db.VarChar(100) // User-given name like "Main USD", "Trading USDT"

  // Balances (DECIMAL for financial precision — never use float!)
  balance         Decimal @default(0) @db.Decimal(28, 18)
  frozenBalance   Decimal @default(0) @map("frozen_balance") @db.Decimal(28, 18) // Held for pending ops
  availableBalance Decimal @default(0) @map("available_balance") @db.Decimal(28, 18)

  // Crypto-specific
  address    String?  @db.VarChar(255) // Deposit address
  publicKey  String?  @map("public_key") @db.VarChar(255)

  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyId], references: [id])

  transactionsFrom Transaction[] @relation("FromWallet")
  transactionsTo   Transaction[] @relation("ToWallet")
  cardTransactions CardTransaction[]

  @@unique([userId, currencyId, type], name: "unique_user_currency_wallet")
  @@index([userId])
  @@index([address])
  @@map("wallets")
}

// ─────────────────────────────────────────────────────────────────────────────
// TRANSACTIONS (the beating heart)
// ─────────────────────────────────────────────────────────────────────────────

model Transaction {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referenceId     String            @unique @map("reference_id") @db.VarChar(30) // Public-facing TXN-XXXX
  userId          String            @map("user_id") @db.Uuid
  type            TransactionType
  status          TransactionStatus @default(PENDING)

  // Wallets involved
  fromWalletId    String? @map("from_wallet_id") @db.Uuid
  toWalletId      String? @map("to_wallet_id") @db.Uuid

  // Amounts (always stored positive; type/direction indicates flow)
  amount          Decimal @db.Decimal(28, 18)
  fee             Decimal @default(0) @db.Decimal(28, 18)
  netAmount       Decimal @map("net_amount") @db.Decimal(28, 18) // amount - fee
  currencyCode    String  @map("currency_code") @db.VarChar(10)

  // Exchange (when converting currencies)
  exchangeRate    Decimal? @map("exchange_rate") @db.Decimal(28, 18)
  toCurrencyCode  String?  @map("to_currency_code") @db.VarChar(10)
  toAmount        Decimal? @map("to_amount") @db.Decimal(28, 18)

  // Blockchain (for crypto transactions)
  txHash          String? @map("tx_hash") @db.VarChar(255) // On-chain TX hash
  blockNumber     BigInt? @map("block_number")
  confirmations   Int     @default(0)
  network         CryptoNetwork?

  // External references
  externalId      String? @map("external_id") @db.VarChar(255) // Gateway/provider reference
  gatewayResponse Json?   @map("gateway_response") @db.JsonB // Raw response from payment/crypto gateway

  // Metadata
  description     String? @db.VarChar(500)
  metadata        Json?   @db.JsonB // Flexible extra data
  ipAddress       String? @map("ip_address") @db.VarChar(45)

  // Risk & compliance
  riskScore       Int?    @map("risk_score") // 0-100
  flagged         Boolean @default(false)
  flagReason      String? @map("flag_reason") @db.VarChar(500)
  reviewedBy      String? @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at")

  // Timestamps
  processedAt     DateTime? @map("processed_at")
  completedAt     DateTime? @map("completed_at")
  failedAt        DateTime? @map("failed_at")
  cancelledAt     DateTime? @map("cancelled_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  fromWallet      Wallet? @relation("FromWallet", fields: [fromWalletId], references: [id])
  toWallet        Wallet? @relation("ToWallet", fields: [toWalletId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([referenceId])
  @@index([txHash])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("transactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// CARDS
// ─────────────────────────────────────────────────────────────────────────────

model Card {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  type          CardType
  status        CardStatus  @default(PENDING_ACTIVATION)
  brand         CardBrand   @default(VISA)
  variant       CardVariant @default(DARK)
  label         String?     @db.VarChar(100)

  // Card details (encrypted in a real system — stored as masked here)
  last4         String      @db.VarChar(4)
  expiryMonth   Int         @map("expiry_month")
  expiryYear    Int         @map("expiry_year")
  holderName    String      @map("holder_name") @db.VarChar(100)

  // Tokenized card reference from payment provider (Stripe, Adyen, etc.)
  providerCardId String?    @map("provider_card_id") @db.VarChar(255)
  providerData   Json?      @map("provider_data") @db.JsonB

  // Limits
  dailyLimit     Decimal    @default(5000) @map("daily_limit") @db.Decimal(18, 2)
  monthlyLimit   Decimal    @default(50000) @map("monthly_limit") @db.Decimal(18, 2)
  dailySpent     Decimal    @default(0) @map("daily_spent") @db.Decimal(18, 2)
  monthlySpent   Decimal    @default(0) @map("monthly_spent") @db.Decimal(18, 2)
  singleTxLimit  Decimal    @default(2500) @map("single_tx_limit") @db.Decimal(18, 2)

  // Settings
  currencyCode   String     @default("USD") @map("currency_code") @db.VarChar(10)
  onlineEnabled  Boolean    @default(true) @map("online_enabled")
  contactless    Boolean    @default(true)
  internationalEnabled Boolean @default(true) @map("international_enabled")

  // Linked wallet
  linkedWalletId String?    @map("linked_wallet_id") @db.Uuid

  // Physical card
  shippingAddress Json?     @map("shipping_address") @db.JsonB
  activatedAt     DateTime? @map("activated_at")

  frozenAt    DateTime? @map("frozen_at")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CardTransaction[]

  @@index([userId])
  @@index([status])
  @@index([last4])
  @@map("cards")
}

model CardTransaction {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId         String            @map("card_id") @db.Uuid
  walletId       String            @map("wallet_id") @db.Uuid
  status         TransactionStatus @default(PENDING)

  amount         Decimal           @db.Decimal(18, 2)
  currencyCode   String            @map("currency_code") @db.VarChar(10)
  merchantName   String?           @map("merchant_name") @db.VarChar(255)
  merchantCategory String?         @map("merchant_category") @db.VarChar(100) // MCC code
  merchantCity   String?           @map("merchant_city") @db.VarChar(100)
  merchantCountry String?          @map("merchant_country") @db.VarChar(3)

  isOnline       Boolean           @default(false) @map("is_online")
  isContactless  Boolean           @default(false) @map("is_contactless")
  isInternational Boolean          @default(false) @map("is_international")

  // Provider reference
  authorizationCode String?        @map("authorization_code") @db.VarChar(50)
  providerTxId      String?        @map("provider_tx_id") @db.VarChar(255)

  description    String?           @db.VarChar(500)
  processedAt    DateTime?         @map("processed_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([cardId])
  @@index([walletId])
  @@index([createdAt])
  @@map("card_transactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// KYC DOCUMENTS
// ─────────────────────────────────────────────────────────────────────────────

model KycDocument {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  type       KycDocumentType
  status     KycStatus       @default(PENDING)

  fileUrl    String          @map("file_url") @db.VarChar(500) // S3/R2 URL
  fileHash   String?         @map("file_hash") @db.VarChar(64) // SHA-256 for integrity
  mimeType   String?         @map("mime_type") @db.VarChar(50)
  fileSize   Int?            @map("file_size") // bytes

  // Provider verification
  providerDocId  String?     @map("provider_doc_id") @db.VarChar(255)
  providerResult Json?       @map("provider_result") @db.JsonB

  reviewedBy   String?       @map("reviewed_by") @db.Uuid
  reviewNote   String?       @map("review_note") @db.VarChar(500)
  reviewedAt   DateTime?     @map("reviewed_at")
  expiresAt    DateTime?     @map("expires_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type, status])
  @@map("kyc_documents")
}

// ─────────────────────────────────────────────────────────────────────────────
// BENEFICIARIES (saved recipients for transfers)
// ─────────────────────────────────────────────────────────────────────────────

model Beneficiary {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  label         String  @db.VarChar(100) // "João's Wallet", "Mom"
  currencyCode  String  @map("currency_code") @db.VarChar(10)

  // Fiat beneficiary
  bankName      String? @map("bank_name") @db.VarChar(255)
  accountNumber String? @map("account_number") @db.VarChar(50)
  routingNumber String? @map("routing_number") @db.VarChar(50)
  swiftBic      String? @map("swift_bic") @db.VarChar(11)
  iban          String? @db.VarChar(34)

  // Crypto beneficiary
  walletAddress String? @map("wallet_address") @db.VarChar(255)
  network       CryptoNetwork?

  // Internal transfer (pagwave-to-pagwave)
  recipientUserId String? @map("recipient_user_id") @db.Uuid
  recipientEmail  String? @map("recipient_email") @db.VarChar(255)

  isFavorite Boolean  @default(false) @map("is_favorite")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("beneficiaries")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String             @db.VarChar(255)
  body      String             @db.Text
  data      Json?              @db.JsonB // Extra payload (tx ID, card ID, etc.)
  isRead    Boolean            @default(false) @map("is_read")
  readAt    DateTime?          @map("read_at")
  sentAt    DateTime?          @map("sent_at")
  createdAt DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG (immutable — compliance requirement)
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  action    AuditAction
  resource  String?     @db.VarChar(100) // "wallet", "card", "transaction"
  resourceId String?    @map("resource_id") @db.VarChar(100)
  details   Json?       @db.JsonB
  ipAddress String?     @map("ip_address") @db.VarChar(45)
  userAgent String?     @map("user_agent") @db.VarChar(500)
  createdAt DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// API KEYS (for programmatic access / merchant integrations)
// ─────────────────────────────────────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String    @db.VarChar(100) // "My Store Integration"
  keyPrefix   String    @map("key_prefix") @db.VarChar(12) // "pk_live_XXXX" — shown in UI
  keyHash     String    @map("key_hash") @db.VarChar(255) // bcrypt hash of the full key
  permissions Json      @db.JsonB // ["transactions:read", "wallets:read", etc.]
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyPrefix])
  @@index([userId])
  @@map("api_keys")
}

// ─────────────────────────────────────────────────────────────────────────────
// FEE CONFIGURATION (admin-managed)
// ─────────────────────────────────────────────────────────────────────────────

model FeeConfig {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionType TransactionType @map("transaction_type")
  currencyCode   String          @map("currency_code") @db.VarChar(10)
  
  // Fee can be flat, percentage, or both
  flatFee        Decimal         @default(0) @map("flat_fee") @db.Decimal(18, 8)
  percentFee     Decimal         @default(0) @map("percent_fee") @db.Decimal(8, 6) // e.g. 0.015 = 1.5%
  minFee         Decimal         @default(0) @map("min_fee") @db.Decimal(18, 8)
  maxFee         Decimal?        @map("max_fee") @db.Decimal(18, 8)

  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@unique([transactionType, currencyCode])
  @@map("fee_configs")
}

// ─────────────────────────────────────────────────────────────────────────────
// WITHDRAWAL LIMITS (per KYC level)
// ─────────────────────────────────────────────────────────────────────────────

model WithdrawalLimit {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kycLevel     Int     @map("kyc_level") // 0, 1, 2, 3
  currencyCode String  @map("currency_code") @db.VarChar(10)
  dailyLimit   Decimal @map("daily_limit") @db.Decimal(18, 2)
  monthlyLimit Decimal @map("monthly_limit") @db.Decimal(18, 2)
  singleTxMax  Decimal @map("single_tx_max") @db.Decimal(18, 2)

  @@unique([kycLevel, currencyCode])
  @@map("withdrawal_limits")
}
