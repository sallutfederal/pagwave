# Pagwave Web App (Next.js)
# Copy to .env.local for local development if you change the backend port.
BACKEND_URL="http://localhost:4000/api/v1"

# XPag Acquirer API (defaults to public Sandbox credentials if omitted)
XPAG_BASE_URL="https://api.xpag.global"
XPAG_CLIENT_ID="xpagsandbox_00000000"
XPAG_CLIENT_SECRET="202620262026202620262026"
# Public HTTPS URL that receives XPag POST webhooks (optional in local dev)
XPAG_WEBHOOK_URL=""

# Master secret used to encrypt per-user Pagwave API keys at rest
PAGWAVE_KEY_MASTER_SECRET=""
# Shared secret between Next.js and Fastify internal gateway routes
INTERNAL_SERVICE_SECRET="pagwave-internal-dev-secret-change-me"
